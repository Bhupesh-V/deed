{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Just Clean",
            "type": "shell",
            "command": "just clean"
        },
        {
            "label": "Just Env",
            "type": "shell",
            "command": "just env"
        },
        {
            "label": "Build Deed",
            "type": "shell",
            "command": "go build -gcflags='all=-N -l' -o deed",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Just Clean",
                "Just Env"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$go"
            ]
        }
    ]
}