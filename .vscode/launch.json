{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Deed",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/deed",
      "preLaunchTask": "Build Deed",
      "args": [
        "seed",
        "--dsn",
        "postgres://postgres:my_secure_password@127.0.0.1:5433/postgres",
        "--tables=system_event_logs",
        "--count=100000",
        "--config=tests/postgres/deed.json"
      ]
    }
  ]
}